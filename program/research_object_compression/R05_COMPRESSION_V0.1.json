    {"item_id":"R05:DEF:DYNAMIC_GENERATOR","item_kind":"DEFINITION","content":"M is the state manifold; F is the unobserved generator; F_hat is reconstructed from D_N^sigma.","source_parse_units":["R05:P:MATH:DYNAMIC_GENERATOR"]},
    {"item_id":"R05:DEF:LIE_TREE","item_kind":"DEFINITION","content":"Lie_0=span{F_hat}; Lie_k is built from iterated brackets with lower-depth algebra elements.","source_parse_units":["R05:P:MATH:LIE_TREE"]},
    {"item_id":"R05:DEF:INVARIANT_CLASS","item_kind":"DEFINITION","content":"Inv_hat_k is the kernel of Lie derivatives over the estimated depth-k algebra.","source_parse_units":["R05:P:MATH:INVARIANT_CLASS"]},
    {"item_id":"R05:DEF:GAUGE_STABILIZER","item_kind":"DEFINITION","content":"The empirical gauge stabilizer is the compact-domain transformation set preserving estimated invariants within epsilon_k under the jet metric.","source_parse_units":["R05:P:MATH:GAUGE_STABILIZER"]},
    {"item_id":"R05:FORMAL:EPSILON","item_kind":"FORMAL_STRUCTURE","content":"epsilon_k=C_k*(sigma^2/N)^(1/2)+epsilon_model.","source_parse_units":["R05:P:MATH:EPSILON_MODEL"]},
