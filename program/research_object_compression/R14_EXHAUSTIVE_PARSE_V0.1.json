      {"id":"R14:P:README:PRIMARY_OBJECT_QUESTION","role":"SOURCE_DESCRIBED_RESEARCH_QUESTION","content":{"primary_object":"Evolution of reachable spaces of future adaptive mechanisms","question":"Does Omega_t -> Delta G_{t+1} contribute causally to long-horizon recursive adaptation?"}},
      {"id":"R14:P:README:SCOPE_CORE_DISTINCTION","role":"SOURCE_DESCRIBED_SCOPE_OR_PURPOSE","content":{"scope":"Causal framework for recursive systems where mechanisms of change become objects of change; explicitly not a theory of intelligence, learning, optimization, alignment, agency, or consciousness.","distinction":"change within a mechanism space != change of the mechanism space itself"}},
