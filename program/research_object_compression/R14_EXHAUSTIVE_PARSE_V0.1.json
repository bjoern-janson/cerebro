      {"id":"R14:P:AGENT:ONTOLOGY","role":"DEFINITION","content":{"X_t":"current system configuration","F_t":"mechanism producing state changes","G_t":"mechanism modifying future transformation mechanisms","Gspace_t":"reachable space of transformation-selection mechanisms","M_t":"internal representation/model","Omega_t":"constraint-bearing information"}},
