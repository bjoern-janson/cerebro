      {"id":"R14:P:README:REPOSITORY_STRUCTURE_CLAIM","role":"PROJECT_PROCESS_METADATA","content":"README describes a repository layout with core/, simulator/{environment,mechanisms,agent,metrics,experiments}, docs/{formalism.md,simulator-spec.md,related-work.md}, and experiments/results. This is preserved as document-described structure, not observed filesystem inventory."},
      {"id":"R14:P:README:FALSIFICATION","role":"METHODOLOGY_OR_TEST_PROTOCOL","content":"Central hypothesis is weakened if long-horizon adaptive capacity persists under novelty, changing constraints, and adversarial perturbations while Omega does not causally influence Delta Gspace."}
    ]},

    {"path":"agent/state.md","blob":"160aa48555f7e5a25a7681e82cd33625d83a88e2","unit_count":12,"units":[
