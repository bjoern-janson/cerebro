      {"id":"R14:P:F1:OPENNESS_PERFORMANCE","role":"DEFINITION","content":{"O_t":"sum(q_i v_i)/sum(q_i)","P_t":"current performance","future_capacity":"A_future(t)","non_equivalence":"P(t) != A_future(t)"}},
      {"id":"R14:P:F1:DEPENDENCY_GRAPH","role":"FORMAL_STRUCTURE","content":"Omega_t -> M_t -> (q_t,v_t) -> Gspace*_t -> pi_t -> G_t -> F_t -> X_t -> Omega_{t+1}."},
