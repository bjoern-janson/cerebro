      {"id":"R14:P:AGENT:MEASUREMENTS_PREDICTION","role":"SOURCE_PREDICTION","content":{"metrics":{"P":"current competence","R":"recovery","E":"discovery","O":"sum(q_i v_i)/sum(q_i)"},"expected":{"early":"P_A approx P_B","later":"O_A > O_B","after_novelty":"R_A > R_B"},"possible_signature":"P up while O down"}},
      {"id":"R14:P:AGENT:FALSIFICATION","role":"METHODOLOGY_OR_TEST_PROTOCOL","content":{"weakening_condition":"long-horizon adaptive capacity maintained without Omega_t -> Delta Gspace_{t+1}","stressors":["repeated novelty","distribution shifts","adversarial perturbations","misleading proxies"],"possible_interpretations":["adaptive-space evolution unnecessary","another mechanism performs same function","decomposition descriptive rather than causal"]}}
    ]},

    {"path":"core/formalism.md","blob":"6a54570e06c44ad416a51456e1db474733961531","unit_count":12,"units":[
