      {"id":"R14:P:AGENT:CAUSAL_STRUCTURE","role":"FORMAL_STRUCTURE","content":{"recursive_chain":"X -> F -> G -> Gspace","constraint_path":"Omega -> M -> G -> F -> X"}},
      {"id":"R14:P:AGENT:CENTRAL_HYPOTHESIS","role":"SOURCE_ASSERTION_HYPOTHESIS","content":"Omega_t -> Delta Gspace_{t+1}; long-horizon recursion may depend on continued viability-relevant constraint influence."},
